<odoo>

    <!-- HERENCIA DEL FORMULARIO DE PRODUCTO -->
    <record id="view_product_form_inherit_stock_alert" model="ir.ui.view">
        <field name="name">product.template.stock.alert.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>

        <field name="arch" type="xml">

            <!-- MÉTODO SEGURO: insertar dentro del formulario -->
            <xpath expr="//sheet" position="inside">
                <group string="Control de Stock">
                    <field name="stock_minimo"/>
                    <field name="alerta_stock" readonly="1"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>