<odoo>

    <record id="view_product_form_inherit_stock_alert" model="ir.ui.view">
        <field name="name">product.template.stock.alert.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>

        <field name="arch" type="xml">

            <!-- Insertar después de código de barras -->
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="stock_minimo"/>
                <field name="alerta_stock" readonly="1"/>
            </xpath>

        </field>
    </record>

</odoo>